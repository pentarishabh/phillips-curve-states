# ===============================================================
# .gitignore for phillips-curve-states
#
# Rule of thumb: ignore secrets, machine-generated artifacts, and
# anything large that can be regenerated from the notebook code.
# Everything that is part of the portfolio deliverable (notebooks,
# processed CSVs, SQL scripts, figures) is intentionally NOT
# excluded here so it ships with the repo.
# ===============================================================


# ---------------------------------------------------------------
# Secrets — never commit API keys
# ---------------------------------------------------------------
# The FRED API key sits at the project root in fred_api_key.txt.
# Committing it would expose a personal credential publicly.
fred_api_key.txt


# ---------------------------------------------------------------
# SQLite database files
# ---------------------------------------------------------------
# data/phillips_curve.db is fully reproducible by re-running
# notebooks/01_data_collection.ipynb against FRED, and the file
# can be tens of MB. We track the schema (sql/create_tables.sql)
# and the analysis-ready CSVs instead.
data/*.db
data/**/*.db


# ---------------------------------------------------------------
# Raw downloaded data
# ---------------------------------------------------------------
# Anything dropped into data/raw/ is, by convention, a direct
# download from a public API that can be re-pulled at any time.
# Tracking it bloats the repo with redundant data.
data/raw/


# ---------------------------------------------------------------
# Python bytecode and caches
# ---------------------------------------------------------------
# Auto-generated by the interpreter and entirely machine-local —
# no value to anyone reading the repo.
__pycache__/
*.pyc
*.pyo
*.pyd


# ---------------------------------------------------------------
# Jupyter checkpoints
# ---------------------------------------------------------------
# Jupyter writes auto-save snapshots to .ipynb_checkpoints/ next
# to every open notebook. These churn constantly and add noise
# to every diff.
.ipynb_checkpoints/


# ---------------------------------------------------------------
# macOS metadata
# ---------------------------------------------------------------
# Finder drops .DS_Store files into every directory it browses.
# They have no value on other systems and create noisy diffs.
.DS_Store
